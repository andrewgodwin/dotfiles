// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "diff_view_style": "unified",
  "format_on_save": "on",
  "buffer_font_family": ".ZedMono",
  "preferred_line_length": 119,
  "soft_wrap": "bounded",
  "agent": {
    "dock": "right",
    "default_model": {
      "provider": "openrouter",
      "model": "qwen/qwen3.8-2.4t-a95b",
      "enable_thinking": true,
    },
    "favorite_models": [
      {
        "provider": "openrouter",
        "model": "qwen/qwen3.8-2.4t-a95b",
        "enable_thinking": true,
      },
    ],
    "model_parameters": [],
  },
  "language_models": {
    "openai_compatible": {},
  },
  "buffer_line_height": {
    "custom": 1.4,
  },
  "project_panel": {
    "dock": "left",
  },
  "ssh_connections": [
    {
      "host": "charmeleon",
      "args": [],
      "projects": [],
    },
  ],
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "agent_servers": {
    "opencode": {
      "type": "registry",
    },
    "claude-acp": {
      "type": "registry",
    },
  },
  "ui_font_size": 16,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "Ayu Dark",
  },
}
